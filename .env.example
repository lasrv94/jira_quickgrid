# Reference only: export variables before starting the backend.
# The app does not automatically load this file.
# Default database: server/jira_app.db (contains unencrypted credentials).
# DATABASE_URL=sqlite:///absolute/path/to/jira_app.db
# Optional Atlassian OAuth fallback; Settings can also store these locally.
# JIRA_CLIENT_ID=your_client_id
# JIRA_CLIENT_SECRET=your_client_secret
# Keep backend and frontend on loopback. See SECURITY.md.
